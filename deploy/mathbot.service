# Install: sudo cp deploy/mathbot.service /etc/systemd/system/ && sudo systemctl enable --now mathbot
# Adjust User and the paths to match where you cloned the project.
[Unit]
Description=Math Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/mathbot
EnvironmentFile=/home/ubuntu/mathbot/.env
ExecStart=/home/ubuntu/mathbot/.venv/bin/python bot.py
Restart=on-failure
RestartSec=10
# Keep a runaway calculation from taking the whole (small) VM down. Lower this on a 1 GB instance.
MemoryMax=800M

[Install]
WantedBy=multi-user.target
