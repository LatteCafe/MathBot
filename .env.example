# Copy to .env and fill in. Never commit .env.
DISCORD_TOKEN=
# Optional: your test server's ID. Commands then appear instantly instead of after up to an hour.
DEV_GUILD_ID=
DATABASE_PATH=data/mathbot.sqlite3
LOG_LEVEL=INFO

# Calculator safeguards
MATH_TIMEOUT_SECONDS=15
MATH_MEMORY_LIMIT_MB=512
MATH_MAX_INPUT_LENGTH=200
MATH_MAX_CONCURRENT=2

# /latex
LATEX_MAX_LENGTH=300

# Problem of the Day
PROBLEMS_PATH=data/problems.yaml

# Status shown in the member list: online | idle | dnd | invisible
BOT_STATUS=online
# A rotating "Playing ..." activity (math-themed). Set to false for none.
PRESENCE_ENABLED=true
PRESENCE_INTERVAL_MINUTES=10
# activity = Playing/Watching/Listening/Competing (reliable); custom = emoji + free text (Discord may not show it for bots)
PRESENCE_STYLE=activity
